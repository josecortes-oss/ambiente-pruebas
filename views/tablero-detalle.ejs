<%- include('layout-head', { titulo: def.titulo || def._id }) %>
<%- include('topbar', { tabs, activoId, esAdmin, invalidos, cambioPendiente }) %>
<div class="shell" id="shell">
  <%- include('chat-panel') %>

  <section class="canvas-area">
    <div class="canvas-toolbar">
      <div class="status-cluster">
        <span class="status-dot"></span>
        <span class="status-copy"><strong>Tablero: <%= def.titulo || def._id %></strong><span><%= def.modelo %></span></span>
      </div>
      <span class="autosave">✓ Evaluación semántica validada</span>
    </div>

    <div class="canvas-scroll">
      <div class="dashboard">
        <div class="dashboard-head">
          <div><h2><%= def.titulo || def._id %></h2><p><%= def.modelo %> · <%= totalRegistros %> registros</p></div>
          <span class="trust-note">◈ Capa semántica validada · fields_get sobre <%= def.modelo %></span>
        </div>

        <% if (grafico) { %>
          <% var tipoGrafico = def.grafico.tipo_grafico || 'barra'; %>
          <% var ETIQUETA_TIPO_GRAFICO = { barra: 'Bar chart', linea: 'Line chart', torta: 'Pie chart' }; %>
          <div class="cards-row">
            <div class="card selectable"
              data-tipo="<%= ETIQUETA_TIPO_GRAFICO[tipoGrafico] %> · <%= def.modelo %>"
              data-titulo="<%= grafico.titulo %>"
              data-metrica="<%= def.grafico.medir %> (suma)"
              data-dimension="<%= def.grafico.agrupar_por %>"
              data-dimension-campo="<%= def.grafico.agrupar_por %>"
              data-modelo="<%= def.modelo %>"
              data-definido-en="tableros/<%= def._id %>.yaml">
              <div class="card-head"><h3><%= grafico.titulo %></h3><p>Click para ver el contexto semántico</p></div>

              <% if (tipoGrafico === 'linea') { %>
                <% var anchoSvg = 400, altoSvg = 160, margenSvg = 18, nSvg = grafico.entradas.length; %>
                <% function xDe(i) { return nSvg > 1 ? margenSvg + (i * (anchoSvg - 2 * margenSvg) / (nSvg - 1)) : anchoSvg / 2; } %>
                <% function yDe(valor) { return altoSvg - margenSvg - ((valor / grafico.max) * (altoSvg - 2 * margenSvg)); } %>
                <svg class="linea-grafico" viewBox="0 0 <%= anchoSvg %> <%= altoSvg %>" preserveAspectRatio="none">
                  <polyline
                    points="<%= grafico.entradas.map(([, valor], i) => xDe(i) + ',' + yDe(valor)).join(' ') %>"
                    fill="none" stroke="var(--accent)" stroke-width="2" />
                  <% grafico.entradas.forEach(([etiqueta, valor], i) => { %>
                    <circle cx="<%= xDe(i) %>" cy="<%= yDe(valor) %>" r="3.5" fill="var(--accent)"><title><%= etiqueta %>: <%= valor.toLocaleString('es-CL', { maximumFractionDigits: 2 }) %></title></circle>
                  <% }) %>
                </svg>
                <div class="linea-etiquetas">
                  <% grafico.entradas.forEach(([etiqueta]) => { %><span title="<%= etiqueta %>"><%= etiqueta %></span><% }) %>
                </div>
              <% } else if (tipoGrafico === 'torta') { %>
                <% var PALETA_TORTA = ['#5b6ee8', '#2fb6a5', '#f2a93b', '#e8618c', '#7c5cf0', '#38b26a', '#e0555a', '#3ba7e0']; %>
                <% var totalTorta = grafico.entradas.reduce((acc, [, valor]) => acc + valor, 0) || 1; %>
                <% var acumuladoTorta = 0; %>
                <% var segmentosTorta = grafico.entradas.map(([, valor], i) => {
                     var pct = (valor / totalTorta) * 100;
                     var inicio = acumuladoTorta;
                     acumuladoTorta += pct;
                     return PALETA_TORTA[i % PALETA_TORTA.length] + ' ' + inicio.toFixed(2) + '% ' + acumuladoTorta.toFixed(2) + '%';
                   }); %>
                <div class="torta-wrap">
                  <div class="torta-circulo" style="background: conic-gradient(<%= segmentosTorta.join(', ') %>)"></div>
                  <div class="torta-leyenda">
                    <% grafico.entradas.forEach(([etiqueta, valor], i) => { %>
                      <div class="torta-item">
                        <span class="torta-color" style="background:<%= PALETA_TORTA[i % PALETA_TORTA.length] %>"></span>
                        <span class="torta-label" title="<%= etiqueta %>"><%= etiqueta %></span>
                        <span class="torta-valor"><%= valor.toLocaleString('es-CL', { maximumFractionDigits: 2 }) %></span>
                      </div>
                    <% }) %>
                  </div>
                </div>
              <% } else { %>
                <div class="bars">
                  <% grafico.entradas.forEach(([etiqueta, valor]) => { %>
                    <div class="bar-row">
                      <span class="bar-label" title="<%= etiqueta %>"><%= etiqueta %></span>
                      <div class="bar-track"><div class="bar-fill" style="width: <%= Math.round((valor / grafico.max) * 100) %>%"></div></div>
                      <span class="bar-value"><%= valor.toLocaleString('es-CL', { maximumFractionDigits: 2 }) %></span>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>

        <div class="card table-card">
          <div class="card-head"><h3>Detalle</h3><p><%= totalRegistros %> registros</p></div>
          <div class="table-wrap">
            <table>
              <thead><tr><% columnas.forEach((c) => { %><th><%= c.etiqueta %></th><% }) %></tr></thead>
              <tbody>
                <% filas.forEach((fila) => { %>
                  <tr><% columnas.forEach((c) => { %><td><%= fila[c.campo] %></td><% }) %></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <footer class="canvas-footer">
      <span>Datos en vivo de la conexión de servicio a Odoo (<%= def.modelo %>).</span>
    </footer>
  </section>

  <%- include('inspector', { cambioPendiente, activoId }) %>
</div>
</body>
</html>
