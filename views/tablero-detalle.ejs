<%- include('layout-head', { titulo: def.titulo || def._id }) %>
<%- include('topbar', { tabs, activoId, esAdmin, invalidos, cambioPendiente }) %>
<div class="shell" id="shell">
  <%- include('chat-panel') %>

  <section class="canvas-area">
    <div class="canvas-toolbar">
      <div class="status-cluster">
        <span class="status-dot"></span>
        <span class="status-copy"><strong>Tablero: <%= def.titulo || def._id %></strong><span><%= def.modelo %></span></span>
      </div>
      <span class="autosave">✓ Evaluación semántica validada</span>
    </div>

    <div class="canvas-scroll">
      <div class="dashboard">
        <div class="dashboard-head">
          <div><h2><%= def.titulo || def._id %></h2><p><%= def.modelo %> · <%= totalRegistros %> registros</p></div>
          <span class="trust-note">◈ Capa semántica validada · fields_get sobre <%= def.modelo %></span>
        </div>

        <% if (grafico) { %>
          <div class="cards-row">
            <div class="card selectable"
              data-tipo="Bar chart · <%= def.modelo %>"
              data-titulo="<%= grafico.titulo %>"
              data-metrica="<%= def.grafico.medir %> (suma)"
              data-dimension="<%= def.grafico.agrupar_por %>"
              data-dimension-campo="<%= def.grafico.agrupar_por %>"
              data-modelo="<%= def.modelo %>"
              data-definido-en="tableros/<%= def._id %>.yaml">
              <div class="card-head"><h3><%= grafico.titulo %></h3><p>Click para ver el contexto semántico</p></div>
              <div class="bars">
                <% grafico.entradas.forEach(([etiqueta, valor]) => { %>
                  <div class="bar-row">
                    <span class="bar-label" title="<%= etiqueta %>"><%= etiqueta %></span>
                    <div class="bar-track"><div class="bar-fill" style="width: <%= Math.round((valor / grafico.max) * 100) %>%"></div></div>
                    <span class="bar-value"><%= valor.toLocaleString('es-CL', { maximumFractionDigits: 2 }) %></span>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>
        <% } %>

        <div class="card table-card">
          <div class="card-head"><h3>Detalle</h3><p><%= totalRegistros %> registros</p></div>
          <div class="table-wrap">
            <table>
              <thead><tr><% columnas.forEach((c) => { %><th><%= c.etiqueta %></th><% }) %></tr></thead>
              <tbody>
                <% filas.forEach((fila) => { %>
                  <tr><% columnas.forEach((c) => { %><td><%= fila[c.campo] %></td><% }) %></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <footer class="canvas-footer">
      <span>Datos en vivo de la conexión de servicio a Odoo (<%= def.modelo %>).</span>
    </footer>
  </section>

  <%- include('inspector', { cambioPendiente, activoId }) %>
</div>
</body>
</html>
