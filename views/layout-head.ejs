<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof titulo !== 'undefined' ? titulo : 'Tableros Odoo' %></title>
  <style>
    :root {
      --ink: #17233d; --muted: #69758d; --line: #dfe5ee; --line-strong: #cbd4e1;
      --surface: #ffffff; --surface-alt: #f6f8fb; --canvas: #eef2f6;
      --accent: #2451c9; --accent-dark: #1c3d9e; --accent-soft: #e9edfc;
      --teal: #0c8f87; --teal-soft: #e5f7f4;
      --success: #167a55; --success-soft: #e7f6ef;
      --danger: #d9534f; --danger-soft: #fdecea;
      --shadow-sm: 0 1px 2px rgba(25,39,66,.06), 0 4px 12px rgba(25,39,66,.04);
      --shadow-lg: 0 18px 46px rgba(25,39,66,.16);
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--canvas); color: var(--ink); font-family: system-ui, -apple-system, "Segoe UI", sans-serif; font-size: 14px; }
    small { color: var(--muted); }
    main { padding: 24px; }

    /* ---- formularios sueltos (login) ---- */
    .form-login { max-width: 320px; margin: 60px auto; background: var(--surface); padding: 24px; border-radius: 14px; box-shadow: var(--shadow-sm); border: 1px solid var(--line); }
    label { display: block; margin-top: 14px; margin-bottom: 6px; font-size: 12px; color: var(--muted); font-weight: 600; }
    input, select {
      display: block; width: 100%; padding: 9px 10px; box-sizing: border-box;
      border: 1px solid var(--line-strong); border-radius: 8px; background: #fff; color: var(--ink); font-size: 14px;
    }
    input:focus, select:focus { outline: 3px solid rgba(36,81,201,.18); border-color: var(--accent); }
    button { padding: 9px 16px; background: var(--accent); color: #fff; border: none; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer; }
    button:hover:not(:disabled) { background: var(--accent-dark); }
    button:disabled { opacity: .55; cursor: not-allowed; }

    .error { background: var(--danger-soft); border: 1px solid #f5c6cb; color: #a33; padding: 12px; border-radius: 8px; white-space: pre-line; max-width: 640px; margin: 24px auto; }

    table { border-collapse: collapse; width: 100%; }
    th { padding: 8px; color: var(--muted); background: #fafbfc; border-bottom: 1px solid var(--line); font-size: 9.5px; font-weight: 750; text-transform: uppercase; text-align: left; }
    td { padding: 9px 8px; border-bottom: 1px solid #edf0f4; font-size: 12px; }
    tr:last-child td { border-bottom: 0; }

    /* ---- topbar ---- */
    .topbar { height: 60px; display: flex; align-items: center; gap: 16px; padding: 0 20px; background: rgba(255,255,255,.97); border-bottom: 1px solid var(--line); position: relative; z-index: 20; }
    .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: inherit; }
    .brand-mark { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 9px; color: #fff; font-weight: 800; background: linear-gradient(145deg, var(--accent), #5a72dd 60%, var(--teal)); box-shadow: 0 6px 16px rgba(36,81,201,.25); }
    .brand-copy { display: grid; line-height: 1.15; }
    .brand-copy strong { font-size: 14px; }
    .brand-copy span { color: var(--muted); font-size: 10.5px; }
    .tabs { display: flex; gap: 4px; margin-left: 8px; flex-wrap: wrap; }
    .tab { padding: 7px 14px; border-radius: 8px; border: 1px solid transparent; background: transparent; color: var(--muted); font-size: 13px; font-weight: 650; cursor: pointer; text-decoration: none; }
    .tab:hover { background: var(--surface-alt); }
    .tab.activo { background: var(--accent-soft); color: var(--accent-dark); border-color: #c9d2f7; }
    .top-actions { margin-left: auto; display: flex; align-items: center; gap: 8px; }
    .icon-button { display: inline-flex; align-items: center; gap: 6px; padding: 0 11px; height: 34px; border: 1px solid var(--line); background: #fff; border-radius: 8px; color: #47536a; font-size: 12px; font-weight: 650; cursor: pointer; text-decoration: none; }
    .icon-button:hover:not(:disabled) { border-color: var(--line-strong); background: #fafbfe; }
    .icon-button:disabled { opacity: .5; cursor: not-allowed; }
    .badge-alerta { padding: 4px 8px; border-radius: 999px; background: #fff4dd; color: #8a5a0d; font-size: 11px; font-weight: 700; }

    /* ---- shell de 3 columnas ---- */
    .shell { height: calc(100vh - 60px); display: grid; grid-template-columns: 320px minmax(0,1fr) 0; transition: grid-template-columns .2s ease; overflow: hidden; }
    .shell.inspector-abierto { grid-template-columns: 320px minmax(0,1fr) 300px; }

    .chat-panel { background: #fff; border-right: 1px solid var(--line); display: grid; grid-template-rows: auto minmax(0,1fr) auto; min-height: 0; }
    .chat-header { padding: 16px 16px 12px; border-bottom: 1px solid #edf0f5; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .agent { display: flex; align-items: center; gap: 10px; }
    .agent-avatar { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 9px; color: #fff; background: var(--accent); font-weight: 800; flex-shrink: 0; }
    .agent-copy strong { display: block; font-size: 13px; }
    .agent-copy span { color: var(--success); font-size: 11px; font-weight: 650; }
    .secure-pill { display: inline-flex; align-items: center; gap: 4px; padding: 4px 7px; border-radius: 999px; background: var(--success-soft); color: var(--success); font-size: 10px; font-weight: 700; white-space: nowrap; }
    .chat-log { overflow-y: auto; padding: 16px; }
    .msg { display: flex; margin: 0 0 12px; }
    .msg.usuario { justify-content: flex-end; }
    .bubble { max-width: 90%; padding: 9px 12px; border-radius: 12px; font-size: 13px; line-height: 1.45; white-space: pre-wrap; box-shadow: var(--shadow-sm); }
    .msg.asistente .bubble { background: var(--surface-alt); border: 1px solid #e8ecf2; border-top-left-radius: 4px; }
    .msg.usuario .bubble { background: var(--accent); color: #fff; border-top-right-radius: 4px; }
    .msg.sistema .bubble { background: #fff4dd; color: #8a5a0d; font-size: 11.5px; border: 1px solid #f0d59f; }
    .composer { padding: 10px 12px 12px; border-top: 1px solid var(--line); }
    .quick-prompt { display: block; width: 100%; margin-bottom: 8px; padding: 8px 10px; border: 1px solid #d9ddfa; border-radius: 8px; background: var(--accent-soft); color: var(--accent-dark); font-size: 11px; font-weight: 700; text-align: left; cursor: pointer; }
    .quick-prompt:hover { background: #e0e5fc; }
    .quick-prompt::before { content: "✦ "; }
    .input-wrap { display: grid; grid-template-columns: minmax(0,1fr) 34px; gap: 6px; padding: 4px; border: 1px solid var(--line-strong); border-radius: 10px; background: #fff; }
    .input-wrap:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(36,81,201,.1); }
    .chat-input { border: 0; outline: 0; padding: 6px 7px; font-size: 13px; background: transparent; margin: 0; }
    .send-button { display: grid; place-items: center; border: 0; border-radius: 7px; color: #fff; background: var(--accent); cursor: pointer; margin: 0; }
    .send-button:hover { background: var(--accent-dark); }
    .composer-note { margin: 8px 3px 0; color: var(--muted); font-size: 10px; }

    .canvas-area { min-width: 0; display: grid; grid-template-rows: auto minmax(0,1fr) auto; background: var(--canvas); overflow: hidden; }
    .canvas-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 48px; padding: 0 18px; background: rgba(249,250,252,.92); border-bottom: 1px solid var(--line); }
    .status-cluster { display: flex; align-items: center; gap: 8px; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 0 4px rgba(12,143,135,.1); flex-shrink: 0; }
    .status-copy strong { font-size: 12px; }
    .status-copy span { color: var(--muted); font-size: 10px; margin-left: 6px; }
    .autosave { padding: 4px 8px; border-radius: 999px; color: var(--success); background: var(--success-soft); font-size: 10px; font-weight: 700; white-space: nowrap; }

    .canvas-scroll { overflow: auto; padding: 20px; }
    .dashboard { width: min(980px, 100%); margin: 0 auto; }
    .dashboard-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; margin-bottom: 14px; flex-wrap: wrap; }
    .dashboard-head h2 { margin: 0; font-size: 22px; letter-spacing: -.02em; }
    .dashboard-head p { margin: 4px 0 0; color: var(--muted); font-size: 12px; }
    .trust-note { display: inline-flex; align-items: center; gap: 6px; padding: 6px 9px; border: 1px solid #cfe9df; border-radius: 8px; color: var(--success); background: rgba(231,246,239,.75); font-size: 10.5px; font-weight: 700; white-space: nowrap; }

    .hero-construir { background: #fff; border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow-sm); padding: 40px 32px; text-align: center; }
    .hero-icono { width: 56px; height: 56px; margin: 0 auto 16px; display: grid; place-items: center; border-radius: 16px; font-size: 26px; background: linear-gradient(145deg, var(--accent-soft), #fff); border: 1px solid #dadefa; }
    .hero-construir h2 { margin: 0 0 6px; font-size: 26px; letter-spacing: -.02em; text-wrap: balance; }
    .hero-subtitulo { margin: 0 auto 10px; max-width: 480px; font-size: 15px; font-weight: 650; color: var(--ink); text-wrap: balance; }
    .hero-construir > p { margin: 0 auto 28px; max-width: 480px; color: var(--muted); font-size: 13px; line-height: 1.5; }
    .chips-modulo { text-align: left; max-width: 560px; margin: 0 auto; }
    .chips-modulo h3 { margin: 0 0 10px; font-size: 11px; font-weight: 750; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
    .chips-modulo h3:not(:first-child) { margin-top: 18px; }
    .chips-fila { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip { padding: 4px 2px; border: none; background: none; color: var(--muted); font-size: 12.5px; font-weight: 400; font-style: italic; cursor: pointer; }
    .chip:hover { color: var(--accent-dark); text-decoration: underline; }

    .barra-filtros { display: flex; align-items: end; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; box-shadow: var(--shadow-sm); }
    .campo-filtro { display: flex; flex-direction: column; gap: 4px; }
    .campo-filtro label { margin: 0; font-size: 11px; text-transform: uppercase; letter-spacing: .03em; }
    .campo-filtro select { min-width: 170px; }
    .barra-filtros button { height: 38px; }
    .barra-filtros .nota { width: 100%; margin: 0; font-size: 11px; color: var(--muted); }

    .kpi-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 12px; }
    .kpi { background: #fff; border: 1px solid #e1e6ed; border-radius: 14px; box-shadow: var(--shadow-sm); padding: 16px; }
    .kpi-top { display: flex; align-items: center; justify-content: space-between; }
    .kpi-label { color: var(--muted); font-size: 11px; font-weight: 700; }
    .kpi-icon { width: 26px; height: 26px; display: grid; place-items: center; border-radius: 8px; color: var(--accent); background: var(--accent-soft); font-size: 13px; flex-shrink: 0; }
    .kpi-value { margin-top: 10px; font-size: 22px; font-weight: 750; letter-spacing: -.02em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .kpi-foot { margin-top: 6px; color: var(--muted); font-size: 10.5px; }
    .kpi-foot .positive { color: var(--success); font-weight: 750; }

    .cards-row, .graficos-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; margin-bottom: 12px; }
    .card, .grafico { background: #fff; border: 1px solid #e1e6ed; border-radius: 14px; box-shadow: var(--shadow-sm); overflow: hidden; margin: 0; }
    .card.selectable { cursor: pointer; transition: box-shadow .15s, border-color .15s; }
    .card.selectable:hover { border-color: #bdc3ee; box-shadow: 0 7px 20px rgba(36,49,79,.08); }
    .card.seleccionado { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(36,81,201,.12); position: relative; }
    .card.seleccionado::after { content: "Seleccionado"; position: absolute; top: 10px; right: 10px; padding: 3px 7px; border-radius: 6px; color: #fff; background: var(--accent); font-size: 9px; font-weight: 750; text-transform: uppercase; }
    .card-head { padding: 14px 16px 6px; }
    .card-head h3, .grafico-titulo { margin: 0; font-size: 12px; font-weight: 750; text-transform: uppercase; letter-spacing: .03em; color: var(--muted); }
    .card-head p { margin: 3px 0 0; color: var(--muted); font-size: 10.5px; }

    .bars, .grafico > .barra-fila { padding: 10px 16px 16px; }
    .grafico { padding-top: 4px; }
    .grafico .barra-fila:first-of-type { margin-top: 10px; }
    .bars { display: grid; gap: 10px; }
    .barra-fila { display: grid; grid-template-columns: 130px minmax(0,1fr) auto; align-items: center; gap: 8px; margin: 0 16px 10px; }
    .bar-row { display: grid; grid-template-columns: 110px minmax(0,1fr) auto; align-items: center; gap: 8px; }
    .barra-etiqueta, .bar-label { font-size: 11px; font-weight: 650; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .barra-pista, .bar-track { height: 9px; border-radius: 999px; background: #edf0f5; overflow: hidden; }
    .barra-relleno, .bar-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--accent), #7488e0); min-width: 2px; }
    .barra-num, .bar-value { font-size: 10px; color: #526078; font-variant-numeric: tabular-nums; white-space: nowrap; }

    .table-card { grid-column: 1 / -1; }
    .table-wrap { overflow-x: auto; padding: 4px 16px 15px; }

    .canvas-footer { display: flex; align-items: center; gap: 8px; min-height: 40px; padding: 8px 18px; border-top: 1px solid var(--line); background: rgba(249,250,252,.95); color: var(--muted); font-size: 10.5px; }

    .inspector { border-left: 1px solid var(--line); background: #fff; overflow: hidden; }
    .inspector-inner { width: 300px; height: 100%; display: grid; grid-template-rows: auto minmax(0,1fr); }
    .inspector-head { display: flex; align-items: center; justify-content: space-between; padding: 15px 16px; border-bottom: 1px solid var(--line); }
    .inspector-head h2 { margin: 0; font-size: 13px; }
    .close-button { width: 26px; height: 26px; border: 0; border-radius: 7px; background: transparent; color: var(--muted); cursor: pointer; font-size: 14px; padding: 0; }
    .close-button:hover { background: var(--surface-alt); }
    .inspector-body { overflow-y: auto; padding: 16px; }
    .selection-card { padding: 12px; border: 1px solid #d7daf5; border-radius: 10px; background: var(--accent-soft); }
    .selection-type { color: var(--accent-dark); font-size: 9px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
    .selection-card strong { display: block; margin-top: 5px; font-size: 12.5px; }
    .selection-id { display: block; margin-top: 3px; color: var(--muted); font: 9px ui-monospace, monospace; }
    .prop-group { margin-top: 16px; }
    .prop-group h3 { margin: 0 0 8px; color: var(--muted); font-size: 9px; letter-spacing: .05em; text-transform: uppercase; }
    .prop-row { display: flex; justify-content: space-between; gap: 10px; padding: 8px 0; border-bottom: 1px solid #edf0f4; font-size: 11px; }
    .prop-row span { color: var(--muted); }
    .prop-row strong { text-align: right; }
    .context-note { margin-top: 14px; padding: 10px; border-radius: 9px; background: var(--teal-soft); color: #23665f; font-size: 10.5px; }
    .context-note strong { display: block; margin-bottom: 3px; color: #0d6f68; }
    .version-item { padding: 10px; border: 1px solid var(--line); border-radius: 9px; background: #fff; margin-bottom: 8px; }
    .version-item.actual { border-color: var(--accent); background: var(--accent-soft); }
    .version-top { display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; }
    .version-top span { color: var(--muted); font-weight: 500; font-size: 9.5px; }
    .version-item p { margin: 5px 0 0; color: var(--muted); font-size: 9.5px; }

    .toast {
      position: fixed; top: 70px; left: 50%; z-index: 40; transform: translate(-50%,-14px);
      display: flex; align-items: center; gap: 8px; padding: 9px 14px; border: 1px solid #cfe4db; border-radius: 9px;
      color: var(--success); background: #fff; box-shadow: var(--shadow-lg); font-size: 12px; font-weight: 700;
      opacity: 0; pointer-events: none; transition: opacity .18s, transform .18s;
    }
    .toast.visible { opacity: 1; transform: translate(-50%,0); }

    [hidden] { display: none !important; }

    @media (max-width: 900px) {
      .shell, .shell.inspector-abierto { grid-template-columns: 1fr; grid-template-rows: 40vh minmax(600px, auto); height: auto; overflow: visible; }
      body { overflow: auto; }
      .inspector { position: fixed; top: 60px; right: 0; bottom: 0; width: 300px; z-index: 30; box-shadow: var(--shadow-lg); }
      .kpi-row, .cards-row, .graficos-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
