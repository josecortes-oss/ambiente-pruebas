<%- include('layout-head', { titulo: 'Tableros disponibles' }) %>
<header>
  <span>Tableros Odoo</span>
  <span><%= usuario.login %> · <a href="/logout">Salir</a></span>
</header>
<main>
  <h2>Tableros disponibles</h2>
  <% if (visibles.length === 0) { %>
    <p>No hay tableros disponibles para tu usuario.</p>
  <% } %>
  <% visibles.forEach((t) => { %>
    <div class="card">
      <a href="/tableros/<%= t._id %>"><%= t.titulo || t._id %></a>
      <div><small><%= t.modelo || 'sale.order + sale.order.line' %><% if (t.modulo) { %> · <%= t.modulo %><% } %></small></div>
    </div>
  <% }) %>

  <% if (esAdmin && invalidos.length > 0) { %>
    <h3>Tableros con errores de evaluación semántica (solo visible para administradores)</h3>
    <% invalidos.forEach((t) => { %>
      <div class="card invalido">
        <strong><%= t.titulo || t._id %></strong> (<%= t._file %>)
        <p class="error"><%= t.errores.join('\n') %></p>
      </div>
    <% }) %>
  <% } %>

  <div class="chat-panel">
    <h3>Asistente de tableros</h3>
    <p class="subt">Comandos de texto fijos (sin IA): consulta datos o modifica tableros genéricos. Escribe <strong>ayuda</strong> para ver la lista completa. Los cambios se validan contra Odoo antes de guardarse.</p>
    <div class="chat-mensajes" id="chat-mensajes"></div>
    <form id="chat-form" class="chat-form">
      <input type="text" id="chat-input" placeholder='Ej. "top clientes" o "ayuda"' autocomplete="off" />
      <button type="submit" id="chat-enviar">Enviar</button>
    </form>
  </div>
</main>
<script>
  (function () {
    var lista = document.getElementById('chat-mensajes');
    var form = document.getElementById('chat-form');
    var input = document.getElementById('chat-input');
    var boton = document.getElementById('chat-enviar');

    function agregarMensaje(texto, clase) {
      var div = document.createElement('div');
      div.className = 'chat-msg ' + clase;
      div.textContent = texto;
      lista.appendChild(div);
      lista.scrollTop = lista.scrollHeight;
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var mensaje = input.value.trim();
      if (!mensaje) return;
      agregarMensaje(mensaje, 'usuario');
      input.value = '';
      boton.disabled = true;

      fetch('/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mensaje: mensaje }),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.error) {
            agregarMensaje('Error: ' + data.error, 'sistema');
            return;
          }
          agregarMensaje(data.respuesta, 'asistente');
          if (data.tableroModificado) {
            agregarMensaje(
              'Tablero "' + data.tableroModificado + '" actualizado. Recarga la página para verlo.',
              'sistema'
            );
          }
        })
        .catch(function (err) {
          agregarMensaje('Error de conexión: ' + err.message, 'sistema');
        })
        .finally(function () {
          boton.disabled = false;
          input.focus();
        });
    });
  })();
</script>
</body>
</html>
